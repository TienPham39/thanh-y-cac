# npm run dev / dev:api load this file and pass the settings to PHP.
# PHP started directly still requires exported environment variables or private config.php.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=thanh_y_cac
DB_USER=thanhycac
DB_PASSWORD=local_dev_change_me
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Absolute private directory outside the web document root:
# TYC_PRIVATE_DIR=/absolute/path/to/tyc-private
# ADMIN_EMAIL=admin@thanhycac.com
# ADMIN_PASSWORD_HASH=<PHP password_hash output; configure in private config.php>
PHP_API_ORIGIN=http://127.0.0.1:8787
# Thanh Y Cac's own payOS channel. Leave blank until configured.
# Never use NEXT_PUBLIC_ or copy another business's keys.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Docker local settings
MYSQL_DATABASE=thanh_y_cac
MYSQL_USER=thanhycac
MYSQL_PASSWORD=local_dev_change_me
MYSQL_ROOT_PASSWORD=local_root_change_me
APP_PORT=3000
