generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Minimal application configuration; add business models as requirements emerge.
model AppSetting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model RentalRequest {
  id String @id @db.VarChar(36)
  productSlug String @db.VarChar(100)
  productCode String @db.VarChar(40)
  productName String @db.VarChar(191)
  name String @db.VarChar(120)
  phone String @db.VarChar(20)
  start String @db.VarChar(10)
  end String @db.VarChar(10)
  height Int?
  weight Int?
  note String @db.Text
  readAt DateTime?
  status String @default("pending") @db.VarChar(20)
  depositConfirmedAt DateTime?
  reservedDays RentalReservedDay[]
  createdAt DateTime @default(now())
  @@index([readAt, createdAt])
}

model RentalReservedDay {
  productSlug String @db.VarChar(100)
  day String @db.VarChar(10)
  requestId String @db.VarChar(36)
  request RentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@id([productSlug, day])
  @@index([requestId])
}

model ProductCategory {
  slug String @id @db.VarChar(80)
  name String @db.VarChar(191)
  position Int @default(0)
  products CostumeProduct[]
}

model CostumeProduct {
  slug String @id @db.VarChar(100)
  code String @unique @db.VarChar(40)
  name String @db.VarChar(191)
  description String @db.Text
  image String @db.VarChar(500)
  images Json?
  price Int
  categorySlug String @db.VarChar(80)
  category ProductCategory @relation(fields: [categorySlug], references: [slug])
  gender String @db.VarChar(20)
  availability String @db.VarChar(20)
  minHeight Int
  maxHeight Int
  minWeight Int
  maxWeight Int
  tags Json
  accessories Json
  badge String @db.VarChar(80)
  badgeTone String @default("red") @db.VarChar(20)
  popularity Int @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, categorySlug, price])
}
